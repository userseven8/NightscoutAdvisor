// Default open-source signing & bundle configuration (mirrors DIY Loop / LoopCaregiver).
// To customize locally without modifying tracked files, create Config/NightscoutAdvisorConfigOverride.xcconfig.

DEVELOPMENT_TEAM =
BUNDLE_ID_PREFIX = org.nightscout.advisor

MAIN_APP_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX)
MAC_APP_BUNDLE_IDENTIFIER = $(MAIN_APP_BUNDLE_IDENTIFIER).mac
WATCH_APP_BUNDLE_IDENTIFIER = $(MAIN_APP_BUNDLE_IDENTIFIER).watchkitapp
WATCH_WIDGETS_BUNDLE_IDENTIFIER = $(WATCH_APP_BUNDLE_IDENTIFIER).widgets
APP_GROUP_IDENTIFIER = group.$(MAIN_APP_BUNDLE_IDENTIFIER)

MARKETING_VERSION = 1.0.0
CURRENT_PROJECT_VERSION = 3

#include? "NightscoutAdvisorConfigOverride.xcconfig"
